# Copy this file to .env and fill in your own values.
#   cp server/.env.example server/.env
# .env is gitignored; this template is safe to commit.

# Email delivery (https://resend.com). Leave blank to log links to the console.
RESEND_API_KEY=
BECHDOU_FROM_EMAIL=Bechdou <onboarding@resend.dev>
BECHDOU_APP_URL=http://localhost:4000

# Signs session tokens. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BECHDOU_SECRET=

# Optional
# PORT=4000
# BECHDOU_DB=./bechdou.db
