# Copy this file to .env and fill in your own values.
#   cp server/.env.example server/.env
# .env is gitignored; this template is safe to commit.

# Email delivery (https://resend.com). Leave blank to log links to the console.
RESEND_API_KEY=
BECHDOU_FROM_EMAIL=Bechdou <onboarding@resend.dev>
BECHDOU_APP_URL=http://localhost:4000

# Signs session tokens. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BECHDOU_SECRET=

# YOUR admin account — REQUIRED before real launch.
# On boot the server creates this account (once) with the admin role, so you
# never depend on the seeded demo login, whose password is public in the
# README. Setting BECHDOU_ADMIN_EMAIL also switches the demo seed OFF, so the
# site starts empty and real. The password is only used to create the account;
# changing it here later does nothing — use "Forgot password" instead.
BECHDOU_ADMIN_EMAIL=
BECHDOU_ADMIN_PASSWORD=
BECHDOU_ADMIN_NAME=Bechdou Admin

# Set to "production" on your live server. This turns off the demo seed and
# makes the server warn loudly about anything still left unconfigured.
NODE_ENV=

# Set to 1 ONLY for a throwaway demo deployment. It re-enables the seeded
# demo accounts and the admin dashboard's "Reset demo data" button, which
# deletes every account, listing and order.
BECHDOU_DEMO=

# Support channels shown on the Contact page and on every listing. Leave
# blank and the contact buttons are hidden rather than pointing at a number
# nobody answers. WhatsApp is digits only, including country code.
BECHDOU_SUPPORT_WHATSAPP=
BECHDOU_SUPPORT_EMAIL=

# Shows the "Style inspiration / Follow" section on the homepage and lights
# up the Instagram icon in the footer. No "@". Leave blank to hide both —
# never point this at an account that doesn't exist.
BECHDOU_INSTAGRAM_HANDLE=

# Payment accounts shown to buyers at checkout — REQUIRED before real launch.
# Buyers pay these directly; there is no payment gateway.
JAZZCASH_ACCOUNT_TITLE=
JAZZCASH_ACCOUNT_NUMBER=
EASYPAISA_ACCOUNT_TITLE=
EASYPAISA_ACCOUNT_NUMBER=
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=
BANK_NAME=

# "Sign in with Google/Facebook" — leave blank to hide those buttons
# entirely; nothing breaks without them. See README for the exact setup
# steps in each provider's console (both require registering this exact
# redirect URL, with your real BECHDOU_APP_URL substituted):
#   Google:   BECHDOU_APP_URL/api/auth/google/callback
#   Facebook: BECHDOU_APP_URL/api/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional
# PORT=4000

# ---------- Hosting ----------
# Number of proxy hops in front of this server. Set to 1 on Render, Railway,
# Fly, or behind nginx. Without it every request looks like it came from the
# load balancer, so the per-IP rate limits apply to the whole site at once —
# ten failed logins from one visitor would lock everybody out.
# Leave unset locally: trusting X-Forwarded-For when nothing sets it lets a
# client spoof its own address.
# BECHDOU_TRUST_PROXY=1

# Both of these MUST point at the host's persistent disk, or every deploy
# wipes your database and every seller photo. On Render with a disk mounted
# at /var/data, use:
#   BECHDOU_DB=/var/data/bechdou.db
#   BECHDOU_UPLOADS_DIR=/var/data/uploads
# BECHDOU_DB=./bechdou.db
# BECHDOU_UPLOADS_DIR=./uploads
