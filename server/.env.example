# Copy this file to .env and fill in your own values.
#   cp server/.env.example server/.env
# .env is gitignored; this template is safe to commit.

# Email delivery (https://resend.com). Leave blank to log links to the console.
RESEND_API_KEY=
BECHDOU_FROM_EMAIL=Bechdou <onboarding@resend.dev>
BECHDOU_APP_URL=http://localhost:4000

# Signs session tokens. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BECHDOU_SECRET=

# Payment accounts shown to buyers at checkout — REQUIRED before real launch.
# Buyers pay these directly; there is no payment gateway.
JAZZCASH_ACCOUNT_TITLE=
JAZZCASH_ACCOUNT_NUMBER=
EASYPAISA_ACCOUNT_TITLE=
EASYPAISA_ACCOUNT_NUMBER=
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=
BANK_NAME=

# "Sign in with Google/Facebook" — leave blank to hide those buttons
# entirely; nothing breaks without them. See README for the exact setup
# steps in each provider's console (both require registering this exact
# redirect URL, with your real BECHDOU_APP_URL substituted):
#   Google:   BECHDOU_APP_URL/api/auth/google/callback
#   Facebook: BECHDOU_APP_URL/api/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional
# PORT=4000
# BECHDOU_DB=./bechdou.db
